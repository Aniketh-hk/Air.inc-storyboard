APP_ENV=local
DATABASE_URL=postgresql://creative:creative@localhost:5432/creative_engine
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=creative-engine
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
REDIS_URL=redis://localhost:6379
WORKFLOW_NAMESPACE=creative-engine-local
LLM_PROVIDER_DEFAULT=mock
IMAGE_PROVIDER_DEFAULT=mock
VIDEO_PROVIDER_DEFAULT=mock
AUDIO_PROVIDER_DEFAULT=mock
SIGNED_URL_TTL_SECONDS=900
MAX_PROJECT_COST=25000
MAX_SHOT_RETRIES=3
PERSONAL_DATA_RETENTION_DAYS=30
OTEL_EXPORTER_ENDPOINT=
SENTRY_DSN=
RENDER_WORKDIR=/tmp/creative-engine-renders
